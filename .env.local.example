# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 如果你用 AI 聊天助手，还需要：
GROQ_API_KEY=你的Groq Key
CHATANYWHERE_API_KEY=你的ChatAnywhere Key

# YouTube 站内音乐搜索（服务端运行时 Secret）
YOUTUBE_API_KEY=你的YouTube Data API Key

# PTE 练习：自托管开源评分服务网关（服务端运行时 Secret，可选）
# 详见 pte-scoring-service/README.md。不配置时口语/写作维度自动回退到本地启发式估分。
# 绝不能加 NEXT_PUBLIC_ 前缀，也不会在客户端代码中读取，只在
# app/api/pte-scoring/*/route.ts 里于服务端使用。
PTE_SCORING_SERVICE_URL=http://your-server-ip:8080
# 启用评分服务时必填；网关侧必须配置同样的值校验 Authorization: Bearer 头
PTE_SCORING_SERVICE_TOKEN=一个你自己生成的随机长字符串

# PTE 商业账号与订阅（默认关闭；现有私人站保持 false）
NEXT_PUBLIC_PTE_COMMERCIAL_MODE=false
PTE_COMMERCIAL_MODE=false
# 商业模式服务端专用，绝不能加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
PTE_SITE_URL=https://pte.example.com
# Stripe Test Mode 服务端 Secret / Webhook signing secret / Recurring Price IDs
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PTE_MONTHLY_PRICE_ID=price_replace_monthly
STRIPE_PTE_YEARLY_PRICE_ID=price_replace_yearly

# PTE AI 助教（默认关闭；客户端开关与服务端开关必须同时开启）
NEXT_PUBLIC_PTE_SUPPORT_AI_ENABLED=false
PTE_SUPPORT_AI_ENABLED=false
