# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 如果你用 AI 聊天助手，还需要：
GROQ_API_KEY=你的Groq Key
CHATANYWHERE_API_KEY=你的ChatAnywhere Key

# YouTube 站内音乐搜索（服务端运行时 Secret）
YOUTUBE_API_KEY=你的YouTube Data API Key

# PTE 练习：自托管开源评分服务网关（服务端运行时 Secret，可选）
# 详见 pte-scoring-service/README.md。不配置时口语/写作维度自动回退到本地启发式估分。
# 绝不能加 NEXT_PUBLIC_ 前缀，也不会在客户端代码中读取，只在
# app/api/pte-scoring/*/route.ts 里于服务端使用。
PTE_SCORING_SERVICE_URL=http://your-server-ip:8080
# 网关与 Next.js 之间的共享密钥（可选但推荐，网关侧也需要配置同样的值校验 Authorization: Bearer 头）
PTE_SCORING_SERVICE_TOKEN=一个你自己生成的随机长字符串
